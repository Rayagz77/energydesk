# EnergyDesk - variables d'environnement (EXEMPLE, valeurs factices)
# Copier en .env puis remplacer chaque "change-me". Ne jamais commiter .env.
# Generer une valeur aleatoire :  python -c "import secrets; print(secrets.token_urlsafe(32))"

APP_ENV=local
LOG_LEVEL=INFO

# Images Docker (nom du compte GitHub en minuscules, et tag)
GITHUB_OWNER=local
IMAGE_TAG=dev

# PostgreSQL
DB_NAME=energydesk
DB_USER=energydesk
DB_PASSWORD=change-me

# Authentification JWT (32 caracteres minimum)
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
JWT_EXPIRE_MINUTES=30

# Stockage objet MinIO (local). Mot de passe : 8 caracteres minimum.
MINIO_ROOT_USER=energydesk-minio
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET_ATTACHMENTS=energydesk-attachments
MAX_UPLOAD_MB=5

# RabbitMQ
RABBITMQ_USER=energydesk
RABBITMQ_PASSWORD=change-me

# Compte agent de demonstration (cree par scripts/demo-compose.ps1)
AGENT_EMAIL=agent@energydesk.local
AGENT_PASSWORD=change-me-agent-2026
