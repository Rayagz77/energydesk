{
  // Environnement Kubernetes pret a l'emploi dans GitHub Codespaces (phases 7 a 12).
  // Machine 4 coeurs / 16 Go : assez pour Minikube + Argo CD + Prometheus/Grafana/Loki.
  "name": "EnergyDesk - Kubernetes",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080, 8443, 3000, 9090, 9093, 8081],
  "portsAttributes": {
    "8080": { "label": "EnergyDesk (HTTP)" },
    "8443": { "label": "EnergyDesk (HTTPS)" },
    "3000": { "label": "Grafana" },
    "9090": { "label": "Prometheus" },
    "9093": { "label": "Alertmanager" },
    "8081": { "label": "Argo CD" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "hashicorp.terraform",
        "ms-python.python",
        "ms-vscode.powershell"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh"
      }
    }
  }
}
